{
  "openapi": "3.0.3",
  "info": {
    "title": "Review Insight AI Backend API",
    "description": "API documentation for the Review Insight PHP Backend, which connects Frontend with Python AI Service.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Check health status",
        "description": "Checks health of the PHP backend and the connection to the Python AI service.",
        "responses": {
          "200": {
            "description": "Successful health check",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "service": {
                      "type": "string",
                      "example": "review-insight-php-backend"
                    },
                    "ai_service": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "example": "ok"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/reviews/upload": {
      "post": {
        "summary": "Upload and analyze CSV file",
        "description": "Uploads a CSV file containing reviews, parses them, sends them to the AI service for analysis, and saves the results in SQLite.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "CSV file containing reviews. Must have at least a review_text column (or aliases)."
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "CSV uploaded and analyzed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "CSV uploaded and analyzed successfully."
                    },
                    "dataset_id": {
                      "type": "integer",
                      "example": 1
                    },
                    "report_id": {
                      "type": "integer",
                      "example": 1
                    },
                    "total_reviews": {
                      "type": "integer",
                      "example": 10
                    },
                    "analytics": {
                      "type": "object"
                    },
                    "insights": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "recommendations": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity (e.g., missing file or invalid format)"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/reviews/analyze-single": {
      "post": {
        "summary": "Analyze a single review",
        "description": "Analyzes a single review manually and saves both the review and analysis results.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "review_text"
                ],
                "properties": {
                  "review_text": {
                    "type": "string",
                    "example": "Late delivery and broken item"
                  },
                  "rating": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5,
                    "example": 1
                  },
                  "review_id": {
                    "type": "string",
                    "example": "manual-1"
                  },
                  "product_id": {
                    "type": "string",
                    "example": "P001"
                  },
                  "product_type": {
                    "type": "string",
                    "example": "phone"
                  },
                  "date": {
                    "type": "string",
                    "format": "date",
                    "example": "2024-01-03"
                  }
                }
              }
            }
          },
        },
        "responses": {
          "201": {
            "description": "Review analyzed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Review analyzed successfully."
                    },
                    "review_id": {
                      "type": "integer",
                      "example": 5
                    },
                    "result": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation error"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/reviews": {
      "get": {
        "summary": "List reviews",
        "description": "Retrieves the list of reviews stored in the database.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 50
            },
            "description": "Maximum number of reviews to return"
          }
        ],
        "responses": {
          "200": {
            "description": "A list of reviews",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/reviews/{id}": {
      "get": {
        "summary": "Get review details",
        "description": "Retrieves details of a specific review by its ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The review ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Review details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Review not found"
          }
        }
      }
    },
    "/api/dashboard": {
      "get": {
        "summary": "Get dashboard stats",
        "description": "Retrieves summary statistics for the dashboard.",
        "responses": {
          "200": {
            "description": "Dashboard stats",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/reports/{id}": {
      "get": {
        "summary": "Get report details",
        "description": "Retrieves details of a specific analysis report by its ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The report ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Report details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Report not found"
          }
        }
      }
    }
  }
}
